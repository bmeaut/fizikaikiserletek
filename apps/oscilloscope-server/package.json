{
  "name": "oscilloscope-server",
  "version": "1.0.0",
  "description": "Hanghullám-oszcilloszkóp tanári szerver",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "hu.fizikaikiserletek.oscilloscope",
